# ============================================================================
# APNA CROP - ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy this file to .env.local and configure your environment-specific values.
# NEVER commit .env or .env.local containing real secrets into version control.
# ============================================================================

# Database Connection URL (SQLite or PostgreSQL / Supabase)
DATABASE_URL=file:procurement.db

# JWT Secret Key for Session Authentication (Use a cryptographically secure random string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# Node Environment
NODE_ENV=development

# Initial System Administrator Credentials (Read strictly by server-side seed script)
ADMIN_INITIAL_NAME="District Procurement Admin"
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace_with_strong_admin_password_123
ADMIN_INITIAL_MOBILE=9999999999
ADMIN_INITIAL_DISTRICT=Nizamabad
ADMIN_INITIAL_STATE=Telangana
ADMIN_INITIAL_VILLAGE="Collectorate HQ"

# Baseline Deduction Configuration (Used only during initial database bootstrap)
DEFAULT_MANDI_FEE_PERCENT=1.5
DEFAULT_LABOR_CHARGE_PER_QUINTAL=20.0
DEFAULT_TRANSPORT_CHARGE_PER_QUINTAL=25.0
